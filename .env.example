# Cliente (públicas, van en el bundle). Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Servidor (solo en Vercel, NUNCA con prefijo VITE_)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Aviso por email de cada reserva (opcional, resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=hola@sinestesya.es
MAIL_FROM=Sinestesya <reservas@tudominio.es>
