# Servidor (solo en Vercel, NUNCA con prefijo VITE_)
SUPABASE_URL=https://xxxx.supabase.co
# Clave de servicio: vale cualquiera de los dos nombres (se aceptan ambos)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Web1: app que recibe las reservas (Klinika).
# URL base, sin /api ni /api/public-reservation (también se aceptan y se normalizan).
WEB1_API_URL=https://gestkli.vercel.app
# Debe coincidir con WEB2_API_SECRET en Web1.
WEB1_API_SECRET=

# Aviso por email de cada reserva (opcional, resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=hola@sinestesya.es
MAIL_FROM=Sinestesya <reservas@tudominio.es>
